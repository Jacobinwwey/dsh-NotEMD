{
  "name": "@notemd-harness/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["lib/**/*.js", "lib/**/*.d.ts"],
  "dependencies": {
    "@notemd-harness/artifacts": "workspace:*",
    "@notemd-harness/jobs": "workspace:*",
    "@notemd-harness/knowledge": "workspace:*",
    "@notemd-harness/llm-openai-compatible": "workspace:*",
    "@notemd-harness/mutation": "workspace:*",
    "@notemd-harness/vault": "workspace:*",
    "@notemd-harness/workspace-events": "workspace:*",
    "@notemd-harness/workflows": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "pnpm run clean:build-output && tsc -p tsconfig.json",
    "clean:build-output": "node -e \"const fs = require('node:fs'); fs.rmSync('lib', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  }
}
