{
  "name": "dsh-notemd",
  "version": "0.1.1",
  "description": "Portable NoteMD workflow bundle for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacobinwwey/dsh-NotEMD.git",
    "directory": "packages/notemd-bundle"
  },
  "homepage": "https://github.com/Jacobinwwey/dsh-NotEMD#readme",
  "bugs": {
    "url": "https://github.com/Jacobinwwey/dsh-NotEMD/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "notemd",
    "markdown",
    "knowledge-management",
    "approval-workflow",
    "mermaid",
    "vega-lite",
    "slidev",
    "svg"
  ],
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "cordis.patch.yml", "README.md", "docs/README.zh-CN.md"],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./vault-local": {
      "types": "./lib/vault-local.d.ts",
      "default": "./lib/vault-local.js"
    },
    "./jobs": {
      "types": "./lib/jobs.d.ts",
      "default": "./lib/jobs.js"
    },
    "./workspace-changes": {
      "types": "./lib/workspace-changes.d.ts",
      "default": "./lib/workspace-changes.js"
    },
    "./knowledge": {
      "types": "./lib/knowledge.d.ts",
      "default": "./lib/knowledge.js"
    },
    "./artifacts": {
      "types": "./lib/artifacts.d.ts",
      "default": "./lib/artifacts.js"
    },
    "./research": {
      "types": "./lib/research.d.ts",
      "default": "./lib/research.js"
    },
    "./llm": {
      "types": "./lib/llm.d.ts",
      "default": "./lib/llm.js"
    },
    "./llm-openai-compatible-legacy": {
      "types": "./lib/llm-openai-compatible-legacy.d.ts",
      "default": "./lib/llm-openai-compatible-legacy.js"
    },
    "./workflows": {
      "types": "./lib/workflows.d.ts",
      "default": "./lib/workflows.js"
    },
    "./composites": {
      "types": "./lib/composites.d.ts",
      "default": "./lib/composites.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./approval": {
      "types": "./lib/approval.d.ts",
      "default": "./lib/approval.js"
    }
  },
  "types": "./lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.5",
    "@deepseek-ai/dsh-web": "0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true }
  },
  "dependencies": {
    "@notemd-harness/artifacts": "workspace:*",
    "@notemd-harness/composites": "workspace:*",
    "@notemd-harness/documents": "workspace:*",
    "@notemd-harness/export-media": "workspace:*",
    "@notemd-harness/export-pptx": "workspace:*",
    "@notemd-harness/export-slidev": "workspace:*",
    "@notemd-harness/jobs": "workspace:*",
    "@notemd-harness/knowledge": "workspace:*",
    "@notemd-harness/llm-dsh": "workspace:*",
    "@notemd-harness/llm-openai-compatible": "workspace:*",
    "@notemd-harness/mutation": "workspace:*",
    "@notemd-harness/process": "workspace:*",
    "@notemd-harness/research": "workspace:*",
    "@notemd-harness/render-circuitikz": "workspace:*",
    "@notemd-harness/render-drawio": "workspace:*",
    "@notemd-harness/render-drawnix": "workspace:*",
    "@notemd-harness/render-editable-svg": "workspace:*",
    "@notemd-harness/render-html": "workspace:*",
    "@notemd-harness/render-json-canvas": "workspace:*",
    "@notemd-harness/render-mermaid": "workspace:*",
    "@notemd-harness/render-vega-lite": "workspace:*",
    "@notemd-harness/tools": "workspace:*",
    "@notemd-harness/vault": "workspace:*",
    "@notemd-harness/vault-local": "workspace:*",
    "@notemd-harness/workspace-events": "workspace:*",
    "@notemd-harness/workflows": "workspace:*",
    "minisearch": "^7.1.2"
  },
  "bundledDependencies": [
    "@notemd-harness/artifacts",
    "@notemd-harness/composites",
    "@notemd-harness/documents",
    "@notemd-harness/export-media",
    "@notemd-harness/export-pptx",
    "@notemd-harness/export-slidev",
    "@notemd-harness/jobs",
    "@notemd-harness/knowledge",
    "@notemd-harness/llm-dsh",
    "@notemd-harness/llm-openai-compatible",
    "@notemd-harness/mutation",
    "@notemd-harness/process",
    "@notemd-harness/research",
    "@notemd-harness/render-circuitikz",
    "@notemd-harness/render-drawio",
    "@notemd-harness/render-drawnix",
    "@notemd-harness/render-editable-svg",
    "@notemd-harness/render-html",
    "@notemd-harness/render-json-canvas",
    "@notemd-harness/render-mermaid",
    "@notemd-harness/render-vega-lite",
    "@notemd-harness/tools",
    "@notemd-harness/vault",
    "@notemd-harness/vault-local",
    "@notemd-harness/workspace-events",
    "@notemd-harness/workflows"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  }
}
