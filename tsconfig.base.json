{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@notemd-harness/mutation": ["packages/notemd-mutation/src/index.ts"],
      "@notemd-harness/composites": ["packages/notemd-composites/src/index.ts"],
      "@notemd-harness/vault": ["packages/notemd-vault/src/index.ts"],
      "@notemd-harness/vault-local": ["packages/notemd-vault-local/src/index.ts"],
      "@notemd-harness/workspace-events": ["packages/notemd-workspace-events/src/index.ts"],
      "@notemd-harness/jobs": ["packages/notemd-jobs/src/index.ts"],
      "@notemd-harness/documents": ["packages/notemd-documents/src/index.ts"],
      "@notemd-harness/mermaid": ["packages/notemd-mermaid/src/index.ts"],
      "@notemd-harness/knowledge": ["packages/notemd-knowledge/src/index.ts"],
      "@notemd-harness/workflows": ["packages/notemd-workflows/src/index.ts"],
      "@notemd-harness/artifacts": ["packages/notemd-artifacts/src/index.ts"],
      "@notemd-harness/process": ["packages/notemd-process/src/index.ts"],
      "@notemd-harness/export-slidev": ["packages/notemd-export-slidev/src/index.ts"],
      "@notemd-harness/export-pptx": ["packages/notemd-export-pptx/src/index.ts"],
      "@notemd-harness/export-media": ["packages/notemd-export-media/src/index.ts"],
      "@notemd-harness/render-mermaid": ["packages/notemd-render-mermaid/src/index.ts"],
      "@notemd-harness/render-vega-lite": ["packages/notemd-render-vega-lite/src/index.ts"],
      "@notemd-harness/render-json-canvas": ["packages/notemd-render-json-canvas/src/index.ts"],
      "@notemd-harness/render-html": ["packages/notemd-render-html/src/index.ts"],
      "@notemd-harness/render-editable-svg": ["packages/notemd-render-editable-svg/src/index.ts"],
      "@notemd-harness/render-drawio": ["packages/notemd-render-drawio/src/index.ts"],
      "@notemd-harness/render-drawnix": ["packages/notemd-render-drawnix/src/index.ts"],
      "@notemd-harness/render-circuitikz": ["packages/notemd-render-circuitikz/src/index.ts"],
      "@notemd-harness/llm-dsh": ["packages/notemd-llm-dsh/src/index.ts"],
      "@notemd-harness/llm-openai-compatible": ["packages/notemd-llm-openai-compatible/src/index.ts"],
      "@notemd-harness/tools": ["packages/notemd-tools/src/index.ts"]
    }
  }
}
