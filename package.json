{
  "name": "notemd-deepseek-harness-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "lint": "eslint . --max-warnings 0",
    "build": "pnpm typecheck && pnpm --recursive --if-present run build",
    "pack:bundle": "pnpm --dir packages/notemd-bundle pack --pack-destination ../../artifacts",
    "verify:bundle": "tsx scripts/verify-bundle.ts",
    "accept:dsh": "tsx scripts/accept-dsh-profile.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
